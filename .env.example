# Supabase project connection — required for the owner dashboard.
# These two values are designed to be public in a browser, but ONLY while
# Row Level Security is enabled and configured (see supabase/schema.sql).
#
# Find these in Supabase Dashboard → Project Settings → API.
# NEVER add a service_role / secret key to a VITE_* variable.

VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_OR_PUBLISHABLE_KEY

# Optional: some newer Supabase projects label it "publishable key".
# VITE_SUPABASE_PUBLISHABLE_KEY=
